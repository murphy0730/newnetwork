# 数据文件（运行时生成）
data/*
!data/.gitkeep
*.sqlite
*.sqlite-shm
*.sqlite-wal

# 测试相关
test-output/
tests/*
!tests/*.test.js
!tests/*-benchmark.js
!tests/benchmark.js
!tests/browser.js
!tests/build-browser.js
!tests/adjust-import-browser.js
!tests/ui-browser.js
!tests/response-benchmark.js
*.log

# 离线构建输入与运行产物
# import/ 是 /api/import/folder 一键导入的默认目录（可用 IMPORT_DIR 覆盖），
# 只保留说明文件，放入的表格属业务数据不入库
import/*
!import/*.txt
build-output/
*.supply
*.supply.partial*

# 本地工具数据
.workbuddy/

# 旧版遗留页面
index.legacy.html

# 依赖与环境
node_modules/
.env
.env.local
