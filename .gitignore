# 数据文件（运行时生成）
data/*
!data/.gitkeep
*.sqlite
*.sqlite-shm
*.sqlite-wal

# 测试相关
# tests/ 下只跟踪「回归脚本与基准脚本」，其余（临时脚本、抓包草稿、单次排查脚本）默认忽略。
# 白名单用通配而不是逐条枚举：新增 *-browser.js（浏览器回归）或 shot-*.js（截图/取样）
# 会自动入库，避免再出现「脚本写了、git status 看不见」的盲区。
test-output/
tests/*
!tests/*.test.js
!tests/*-benchmark.js
!tests/benchmark.js
!tests/*-browser.js
!tests/browser.js
!tests/shot-*.js
*.log

# 离线构建输入与运行产物
# import/ 是 /api/import/folder 一键导入的默认目录（可用 IMPORT_DIR 覆盖），
# 只保留说明文件，放入的表格属业务数据不入库
import/*
!import/*.txt
build-output/
*.supply
*.supply.partial*

# 打包分发产物（dist-package/ 是发行包目录快照，含业务表格与运行时数据；*.zip 是分发压缩包）
dist-package/
*.zip

# 本地工具数据
.workbuddy/

# 旧版遗留页面
index.legacy.html

# 依赖与环境
node_modules/
.env
.env.local
